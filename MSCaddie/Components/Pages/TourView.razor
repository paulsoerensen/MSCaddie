@page "/TourView"
@using BlazorBootstrap;

@* @attribute [AuthorizeRoles(Roles.Admin, Roles.Presidium)] *@

<PageTitle>Ture</PageTitle>


@if (tours == null)
{
    <div Position="Position.Absolute.Top.Is50.Start.Is50.Translate.Middle"><DisplaySpinner /></div>
}
else
{
    <RadzenTabs Change=@OnChange  TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client">
        <Tabs>
            @foreach (var tour in tours)
            {
                <RadzenTabsItem Text=@tour.Description>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>

    <AuthorizeView>
        <Authorized>
            <RadzenRow Gap="0.5rem" RowGap="0.5rem">
                <RadzenColumn Size="12" class="rz-p-1">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" 
                    AlignItems="AlignItems.Start" class="rz-p-4 rz-border-radius-1" 
                    Style="border: var(--rz-grid-cell-border);"
                    JustifyContent="JustifyContent.Normal" >
                        <div class="rz-p-2 rz-text-align-center">
                            <BlazorBootstrap.AutoComplete @bind-Value="Fullname"
                            TItem="TourPlayerModel"
                            DataProvider="TourPlayerProvider"
                            PropertyName="Fullname"
                            Placeholder="Vælg spiller..."
                            StringComparison="StringComparison.Ordinal"
                            OnChanged="(TourPlayerModel res) => OnAutoCompleteChanged(res)" />
                        </div>
                                <RadzenButton Icon="save" Click="@(args => Subscribe())" 
                                    ButtonStyle="ButtonStyle.Success" Disabled="@(player.VgcNo is null)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </Authorized>
    </AuthorizeView>

    <div class="container">
        <div class="row py-5">
            <RadzenDataGrid @ref="playerGrid" AllowFiltering="false" AllowGrouping="true"
            Render="@OnRender" AllowPaging="false" AllowSorting="true"
            Data="@players" TItem="TourPlayerModel" AllowVirtualization="true" AllowColumnResize="true"
            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
            LogicalFilterOperator="LogicalFilterOperator.Or" FilterPopupRenderMode="PopupRenderMode.OnDemand">

                <Columns>
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="VgcNo" Title="VGC Nr." Width="8rem" />
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="Fullname" Title="Navn" Width="12rem" />
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="Opdateret" Title="Dato" Width="8rem">
                        <Template Context="data">
                            @(data.LastUpdateDisplay)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="LastUpdateBy" Title="Opdateret af" Width="12rem" />
                    <AuthorizeView>
                       <Authorized>
                        <RadzenDataGridColumn Context="data" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="data">
                                <RadzenButton Icon="cached" title="Tilmeld" Click="@(args => Unsubscribe(data.VgcNo))" ButtonStyle="ButtonStyle.Success" />
                            </Template>
                        </RadzenDataGridColumn> 
                        </Authorized>
                    </AuthorizeView>

                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}
@code {
    public List<TourModel> tours;
    public List<TourPlayerModel?> players;
    public List<TourPlayerModel?> nonPlayers;
    public TourModel? tour;
    protected RadzenDataGrid<TourPlayerModel> playerGrid;

    protected TourPlayerModel player { get; set; } = new TourPlayerModel();
    protected string Fullname;

    [Inject] public ITourService tourSvc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        tours = (await tourSvc.GetTours())?.ToList() ?? new List<TourModel>();
        await OnChange(0);
    }

    protected async Task OnChange(int index)
    {
        tour = tours.ElementAtOrDefault(index);
        await RefreshPlayers();
    }

    protected async Task RefreshPlayers()
    {
        if (tour != null)
        {
            players = (await tourSvc.GetTourPlayers(tour.TourId))?.ToList() ?? new List<TourPlayerModel?>();
        }
        else {
            players = new List<TourPlayerModel?>();
        }
    }

    protected async Task Subscribe()
    {
        await tourSvc.Subscribe(tour.TourId, player.VgcNo.Value);
        await RefreshPlayers();
        player = new TourPlayerModel(); 
    }

    protected async Task Unsubscribe(int? vgcNo)
    {
        await tourSvc.ToggleSubscribtion(tour.TourId, vgcNo.Value);
        await RefreshPlayers();
    }

    void OnRender(DataGridRenderEventArgs<TourPlayerModel> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Groups.Add(new GroupDescriptor() { Property = "Tilmeldt", SortOrder = SortOrder.Descending });
            StateHasChanged();
        }
    }

    protected async Task<AutoCompleteDataProviderResult<TourPlayerModel>> TourPlayerProvider(AutoCompleteDataProviderRequest<TourPlayerModel> request)
    {
        if (nonPlayers == null)
        {
            nonPlayers = new List<TourPlayerModel>(); // Initialize as an empty set if results is null
        }

        // If results is empty, fetch the data from the service
        if (!nonPlayers.Any())
        {
            nonPlayers = (await tourSvc.GetNonTourPlayers(tour.TourId))?.ToList() ?? new List<TourPlayerModel?>();
        }

        // Filter results based on the request filter value
        var filteredResults = nonPlayers.Where(x => x.Fullname.Contains(request.Filter.Value, StringComparison.OrdinalIgnoreCase)).ToList();

        // Return the filtered results in an AutoCompleteDataProviderResult
        return await Task.FromResult(new AutoCompleteDataProviderResult<TourPlayerModel>
            {
                Data = nonPlayers, // return filtered results
                TotalCount = nonPlayers.Count // return filtered count
            });
    }
    protected void OnAutoCompleteChanged(TourPlayerModel res)
    {
        player = res;
    }
}