@page "/TourView"
@using BlazorBootstrap;

@* @attribute [AuthorizeRoles(Roles.Admin, Roles.Presidium)] *@

<PageTitle>Ture</PageTitle>


@if (tours == null)
{
    <div Position="Position.Absolute.Top.Is50.Start.Is50.Translate.Middle"><DisplaySpinner /></div>
}
else
{
    <RadzenTabs Change=@OnTourChange  TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client">
        <Tabs>
            @foreach (var tour in tours)
            {
                <RadzenTabsItem Text=@tour.Description>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>

    <AuthorizeView>
        <Authorized>
            <RadzenRow Gap="0.5rem" RowGap="0.5rem">
                <RadzenColumn Size="12" class="rz-p-1">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" 
                    AlignItems="AlignItems.Start" class="rz-p-4 rz-border-radius-1" 
                    Style="border: var(--rz-grid-cell-border);"
                    JustifyContent="JustifyContent.Normal" >
                        <PlayerSelection Players="@nonPlayers" 
                            SelectedItemChanged="HandlePlayerSelected"
                            PropertyValue="@Fullname" />
                        <RadzenButton Icon="save" Click="@(args => Subscribe())"
                        ButtonStyle="ButtonStyle.Success" Disabled="@(player == null)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </Authorized>
    </AuthorizeView>

    <div class="container">
        <div class="row py-5">
            <RadzenDataGrid @ref="playerGrid" AllowFiltering="false" 
            AllowPaging="false" AllowSorting="true"
            Data="@players" TItem="TourPlayerModel" AllowVirtualization="true" AllowColumnResize="true"
            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
            LogicalFilterOperator="LogicalFilterOperator.Or" FilterPopupRenderMode="PopupRenderMode.OnDemand">

                <Columns>
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="VgcNo" Title="VGC Nr." Width="8rem" />
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="Fullname" Title="Navn" Width="20rem" />
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="Opdateret" Title="Dato" Width="10rem">
                        <Template Context="data">
                            @(data.LastUpdateDisplay)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TourPlayerModel" Property="LastUpdateBy" Title="Opdateret af" Width="12rem" />
                    <AuthorizeView>
                        <Authorized>
                            <RadzenDataGridColumn Context="data" TextAlign="TextAlign.Right" Filterable="false">
                                <Template Context="data">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" 
                                    Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => Unsubscribe(data.VgcNo))" @onclick:stopPropagation="true" />
                                </Template>
                            </RadzenDataGridColumn> 
                        </Authorized>
                    </AuthorizeView>

                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}
@code {
    public TourModel? tour;
    public List<TourModel> tours;
    public List<TourPlayerModel?> players;
    protected RadzenDataGrid<TourPlayerModel> playerGrid;

    public List<PlayerModel?> nonPlayers = null;
    protected PlayerModel? player { get; set; }
    protected string Fullname;

    [Inject] public ITourService tourSvc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        tours = (await tourSvc.GetTours())?.ToList() ?? new List<TourModel>();
        await OnTourChange(0);
    }

    protected async Task OnTourChange(int index)
    {
        tour = tours.ElementAtOrDefault(index);
        await RefreshPlayers();
    }

    protected async Task RefreshPlayers()
    {
        if (tour != null)
        {
            players = (await tourSvc.GetTourPlayers(tour.TourId))?.ToList() ?? new List<TourPlayerModel?>();
            nonPlayers = (await tourSvc.GetNonTourPlayers(tour.TourId))?.ToList() ?? new List<PlayerModel?>();
        }
        else {
            players = new List<TourPlayerModel?>();
            nonPlayers = null;
        }
        player = null;
        Fullname = "";
        StateHasChanged();
    }

    protected async Task Subscribe()
    {
        await tourSvc.Subscribe(tour.TourId, player.VgcNo);
        await RefreshPlayers();
    }

    protected async Task Unsubscribe(int? vgcNo)
    {
        await tourSvc.Unsubscribe(tour.TourId, vgcNo.Value);
        await RefreshPlayers();
    }

    protected async Task HandlePlayerSelected(PlayerModel model)
    {
        player = model;
        Fullname = model?.Fullname ?? "";
    }
}