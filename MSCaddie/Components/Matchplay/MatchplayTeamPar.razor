@inherits MatchplayTeamParBase

@using System.Linq;
@using MSCaddie.Shared.Services


@rendermode InteractiveServer

@if (teams is null)
{
    <DisplaySpinner/>
}
else {

    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <DropdownComponent TItem="PlayerModel"
                            Items="players"
                               GetKey="GetVgcNo"
                               GetValue="GetFullName"
                            SelectedKey=vgcNo1
                            OnItemSelected="HandlePlayer1Selected" />

        </div>
        <div class="container-fluid">
             <button class="btn btn-primary ms-auto" @onclick="() => CreateTeam()" >Opret par</button>
        </div>
        <div class="container-fluid">
            <DropdownComponent TItem="PlayerModel"
                               Items="players"
                               GetKey="GetVgcNo"
                               GetValue="GetFullName"
                               SelectedKey=vgcNo2
                               OnItemSelected="HandlePlayer2Selected" />

        </div>

    </nav>

    <div class="container">
        <div class="row py-5">
            <RadzenDataGrid @ref="teamsGrid" AllowFiltering="false" FilterMode=FilterMode.Simple AllowPaging="false" AllowSorting="true"
                            Data="@teams" TItem="TeamParModel" AllowVirtualization="true" AllowColumnResize="true">

                <Columns>
                    <RadzenDataGridColumn TItem="TeamParModel" Property="VgcNo" Title="VGC no." Width="6rem" />
                    <RadzenDataGridColumn TItem="TeamParModel" Property="VgcNoPartner" Title="VGC no." Width="6rem" />
                    <RadzenDataGridColumn TItem="TeamParModel" Property="TeamName" Title="Spiller" Width="20rem" />
                    <RadzenDataGridColumn Context="data" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="data">
@*                             <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(data))" title="Add new row after this row" />
 *@                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(data))" @onclick:stopPropagation="true" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" @onclick:stopPropagation="true" />
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(data))" aria-label="Save" />
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(data))" aria-label="Cancel" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" aria-label="Delete" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
               
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}



