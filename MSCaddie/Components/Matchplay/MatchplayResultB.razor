@rendermode InteractiveServer

@if (games is null)
{
    <DisplaySpinner />
}
else
{
    <div class="container">
        <div class="row py-5">
            <RadzenDataGrid @ref="resultGrid" AllowFiltering="false" FilterMode=FilterMode.Simple AllowPaging="false" AllowSorting="true"
                            Data="@games" TItem="MatchplayGameModel" AllowVirtualization="true" AllowColumnResize="true">

                <Columns>
                    <RadzenDataGridColumn TItem="MatchplayGameModel" Property="PlayRound" Title="Runde" Width="6rem" />
                    <RadzenDataGridColumn TItem="MatchplayGameModel" Property="TeamName1" Title="Spiller 1" Width="12rem">
                        <Template Context="data">
                            @if (data.MatchResult == 1)
                            {
                                <span><b>@data.TeamName1</b></span>
                            }
                            else
                            {
                                <span>@data.TeamName1</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchplayGameModel" Property="TeamName2" Title="Spiller 2" Width="12rem">
                        <Template Context="data">
                            @if (data.MatchResult == 2)
                            {
                                <span><b>@data.TeamName2</b></span>
                            }
                            else
                            {
                                <span>@data.TeamName2</span>
                            }
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenDropDown @bind-Value="data.MatchResult" Data="@teams" TextProperty="Value" ValueProperty="Key" Style="width:100%; display: block;"
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Vinder" }})" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchplayGameModel" Property="ResultText" Title="Resultat" Width="12rem">
                        <EditTemplate Context="data">
                            <RadzenTextBox @bind-Value="data.ResultText" Style="width:100px; display: block" Name="ResultText" aria-label="Enter ship country" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Context="data" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="data">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditResult(data))" @onclick:stopPropagation="true" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteResult(data))" @onclick:stopPropagation="true" />
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveResult(data))" aria-label="Save" />
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(data))" aria-label="Cancel" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteResult(data))" aria-label="Delete" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {

    [Inject] public IMatchplayService matchplaySvc { get; set; } = default!;
    protected RadzenDataGrid<MatchplayGameModel> resultGrid;

    public IEnumerable<MatchplayGameModel>? games;
    List<KeyValuePair<int, string>> teams = new List<KeyValuePair<int, string>>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await base.OnInitializedAsync();
    }

    protected async Task LoadData()
    {
        games = await matchplaySvc.GetMatchplayGames('B');
        await base.OnInitializedAsync();
    }

    protected async Task SaveResult(MatchplayGameModel model)
    {
        try
        {
            await matchplaySvc.MatchplayGameUpsert(model);
            await LoadData();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
        }
    }
    protected async Task EditResult(MatchplayGameModel model)
    {
        teams = new List<KeyValuePair<int, string>>();
        teams.Add(new KeyValuePair<int, string>(1, model.TeamName1));
        teams.Add(new KeyValuePair<int, string>(2, model.TeamName2));

        await resultGrid.EditRow(model);
    }

    protected async Task CancelEdit(MatchplayGameModel model)
    {
        resultGrid.CancelEditRow(model);
    }

    protected async Task DeleteResult(MatchplayGameModel model)
    {
        model.ResultText = null;
        model.MatchResult = 0;
        int i = model.MatchplayGameId;
        try
        {
            await matchplaySvc.MatchplayGameDelete(i);
            await LoadData();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
        }
    }
}