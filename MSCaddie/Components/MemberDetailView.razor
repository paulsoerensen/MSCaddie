@page "/MemberDetailView/{playerId:int}"
@inherits MemberDetailViewBase

@rendermode InteractiveServer

@if (player != null)
{
    <RadzenTemplateForm Data="@player" TItem=PlayerModel Submit="@OnSubmit" InvalidSubmit=@OnInvalidSubmit>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start" Wrap="FlexWrap.Wrap" Gap="1rem">

            <RadzenRow AlignItems="AlignItems.End" Visible="@(playerId < 0)">

                <RadzenColumn Size="12">
                    <PlayerSelection Players="@NonMembers" 
                        SelectedItemChanged="HandlePlayerSelected" 
                        PropertyValue="@Fullname" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="VGC Nr." Variant="Variant.Outlined" Style="width: 100%;">
                        <ChildContent>
                            <RadzenNumeric @bind-Value=@player.VgcNo
                                           InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                        </ChildContent>
                        <End>
                            <RadzenButton Click=@(args => HandlePlayerSelected(player)) Icon="refresh" ButtonStyle="ButtonStyle.Primary" />
                        </End>
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Hcp" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenNumeric @bind-Value=@player.HcpIndex />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Fornavn" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Name="Firstname" @bind-Value=@player.Firstname />
                        <RadzenRequiredValidator Component="Firstname" Text="Hvad hedder han ?" Style="position: absolute" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Efternavn" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox Name="Lastname" @bind-Value=@player.Lastname />
                        <RadzenRequiredValidator Component="Lastname" Text="Efternavn, tak !!" Style="position: absolute" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%">
                        <RadzenTextBox Name="Email" @bind-Value=@player.Email />
                        <RadzenEmailValidator Component="Email" Text="Provide a valid email address" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Mobil" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox @bind-Value=@player.Phone />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" class="rz-mt-8 rz-mb-4">
            <RadzenButton ButtonType="ButtonType.Submit" Size="ButtonSize.Medium" Icon="save" Text="Opdater" ButtonStyle="ButtonStyle.Success" />
            <RadzenButton Click="@((args) => dialogService.Close(false))" Text="Fortryd" ButtonStyle="ButtonStyle.Base" Style="width: 120px" />
        </RadzenStack>
    </RadzenTemplateForm>
}

@if (Message != null)
{
    <div class="rz-p-2">
        @Message
    </div>
}