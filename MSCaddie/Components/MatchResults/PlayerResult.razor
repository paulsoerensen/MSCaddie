@inherits PlayerResultBase
@page "/match/{MatchId:int}/playerresult"

@rendermode InteractiveServer

@if (Match == null)
{
    <DisplaySpinner />
}
else
{

    <RadzenRow Gap="0.5rem" RowGap="0.5rem">
        <RadzenColumn Size="12" class="rz-p-1">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start" class="rz-p-4 rz-border-radius-1" Style="border: var(--rz-grid-cell-border);">
                <div class="rz-p-2 rz-text-align-center">
                    <BlazorBootstrap.AutoComplete @bind-Value="Fullname"
                        TItem="MatchResultModel"
                        DataProvider="ResultDataProvider"
                        PropertyName="Fullname"
                        Placeholder="Vælg spiller..."
                        StringComparison="StringComparison.Ordinal"
                        OnChanged="(MatchResultModel res) => OnAutoCompleteChanged(res)" />
                </div>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}
@if (result != null && Match != null)
{
    <RadzenTemplateForm TItem="MatchResultModel" Data=@result Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>
       <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap" Gap="1rem">
            <RadzenFormField Text="Hcp" Variant="@variant" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.HcpIndex" />
            </RadzenFormField>
            <RadzenFormField Text="Antal tildelte" Variant="@variant" Style="flex: 1;">
                <RadzenNumeric Name="Hcp" @bind-Value="@result.Hcp" />
                <RadzenRequiredValidator Component="Hcp" Text="Hcp skal angives"  Style="position: absolute" />
            </RadzenFormField>
            <RadzenFormField Text="Brutto" Variant="@variant" Visible="@Match.IsStrokePlay" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.Brutto" />
            </RadzenFormField>
            <RadzenFormField Text="Hallington" Variant="@variant" Visible="@Match.IsHallington" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.Hallington" />
            </RadzenFormField>
            <RadzenFormField Text="Puts" Variant="@variant" Visible="@Match.IsStrokePlay" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.Puts" />
            </RadzenFormField>
            <RadzenFormField Text="Stableford" Variant="@variant" Style="flex: 1;">
                <RadzenNumeric Name="Stableford" style="display: block"  @bind-Value="@result.Points" />
                <RadzenRequiredValidator Component="Stableford" Text="Points skal angives" Style="position: absolute" />
            </RadzenFormField>
            <RadzenFormField Text="Birdies" Variant="@variant" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.Birdies" />
            </RadzenFormField>
            <RadzenFormField Text="Shoot-out" Variant="@variant" Visible="@Match.Shootout" Style="flex: 1;">
                <RadzenNumeric @bind-Value="@result.Shootout" />
            </RadzenFormField>
        </RadzenStack>

        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="1rem" class="rz-mt-1" Style="justify-content: flex-end;">
            <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="4px">
                <div class="rz-p-1 rz-text-align-left">
                    <RadzenLabel Text="Med i birdies" Component="" class="rz-ms-2" />
                    <RadzenCheckBox @bind-Value="@result.InBirdies" />
                </div>
            </RadzenStack>

            <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="4px">
                <div class="rz-p-1 rz-text-align-left">
                    <RadzenLabel Text="Spiser med" Component="CheckBox1" class="rz-ms-2" />
                    <RadzenCheckBox @bind-Value="@result.Dining" />
                </div>
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="1rem" class="rz-mt-1" Style="justify-content: flex-end;">
            <div class="rz-p-2 .rz-w-fit-content  rz-text-align-left">
                <RadzenButton Text="Opdater" Icon="check_circle" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" />
            </div>
        </RadzenStack>
    </RadzenTemplateForm>
}
@if (Message is not null)
{
    <div class="text-red-500">
        <em>@message</em>
    </div>
}

@if (result != null && Match != null)
{
    <RadzenDataGrid @ref="resultsGrid" AllowColumnResize="true"
                    AllowSorting="true" Data="@registredResults">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.No)" Title="Nr" Width="20px" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.VgcNo)" Title="Vgc nr." FormatString="{0:d}" TextAlign="TextAlign.Center" Width="20px" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Fullname)" Title="Navn" FormatString="{0:d}" TextAlign="TextAlign.Start" Width="180px">
                <Template Context="data">
                    <div class="@(data.Dining ? "" : "fw-light fst-italic")">
                        @data.Fullname
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Hallington)" Title="Resultat" FormatString="{0:d}" Visible="Match.IsHallington" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Brutto)" Title="Brutto" FormatString="{0:d}" Visible="Match.IsStrokePlay" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Hcp)" Title="Hcp" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Netto)" Title="Netto" FormatString="{0:d}" Visible="Match.IsStrokePlay" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Points)" Title="Stableford" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Puts)" Title="Puts" Visible="Match.IsStrokePlay" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="@nameof(MatchResultModel.Birdies)" Title="Birdies" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Context="data" TextAlign="TextAlign.Right" Filterable="false">
                <Template Context="data">
                    <RadzenButton Icon="delete" Click="@(args => OnDelete(data))" ButtonStyle="ButtonStyle.Warning" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

